{
  "name": "plain-html",
  "title": "Plain HTML (Source Serif 4 with Reserved Font Name \"Source\" + JetBrains Mono)",
  "kind": "static",
  "source": "site",
  "dist": ".",
  "paths": [
    "/",
    "/post.html",
    "/code.html",
    "/late.html"
  ],
  "url_prefix": "/fonts/optimized/",
  "fonts": [
    {
      "family": "Source Serif 4",
      "license": "SIL OFL 1.1",
      "source": "https://github.com/adobe-fonts/source-serif (via @fontsource-variable/source-serif-4 5.3.1)",
      "reserved_font_name": "Source",
      "license_file": "LICENSE-source-serif-4.txt"
    },
    {
      "family": "JetBrains Mono",
      "license": "SIL OFL 1.1",
      "source": "https://github.com/JetBrains/JetBrainsMono (via @fontsource-variable/jetbrains-mono 5.3.0)",
      "license_file": "LICENSE-jetbrains-mono.txt"
    }
  ],
  "css_files": [
    "fonts.css"
  ],
  "public_dir": "",
  "preload": "off",
  "expect": {
    "no_font_substring_on": [
      {
        "path": "/post.html",
        "substr": "-ext.woff2"
      },
      {
        "path": "/",
        "substr": "-ext.woff2"
      }
    ],
    "font_substring_on": [
      {
        "path": "/late.html",
        "substr": "-ext.woff2"
      }
    ]
  },
  "scan_paths": [
    "/",
    "/post.html",
    "/code.html"
  ]
}